NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=*

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=syyncin
DB_PASSWORD=syyncin_dev
DB_NAME=syyncin

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# OTP — "mock" logs the code (and returns devCode outside production)
OTP_PROVIDER=mock
OTP_SECRET=dev-otp-secret-change-me
OTP_EXPIRY_SECONDS=60
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_EXPOSE_DEV_CODE=true
# Test login — every OTP is this code (default 123456 outside production). Empty = random codes.
OTP_FIXED_CODE=123456

MIN_AGE=25
UPLOAD_DIR=uploads
MAX_IMAGE_MB=5
# true = selfie auto-verified (demo); false = manual admin approval
AUTO_APPROVE_SELFIE=false

APP_MIN_VERSION=0.1.0
TERMS_URL=https://syyncin.app/terms
PRIVACY_URL=https://syyncin.app/privacy

# Connection requests a member can send per 24 h
MAX_REQUESTS_PER_DAY=30
# Swagger UI at /docs (set false to hide it on a public server)
DOCS_ENABLED=true

# Push notifications (later): none | fcm — see src/services/push.js
PUSH_PROVIDER=none
