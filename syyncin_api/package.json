{
  "name": "syyncin-api",
  "version": "0.1.0",
  "description": "SyyncIn backend — app + admin REST APIs (Node.js, Express, MySQL)",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/migrate.js --seed-only",
    "db:reset": "node scripts/migrate.js --reset",
    "admin:create": "node scripts/create-admin.js",
    "postman": "node scripts/build-postman.js",
    "test:e2e": "node test/e2e.js",
    "db:demo": "node scripts/migrate.js --seed-only --demo",
    "check:responses": "node scripts/check-responses.js",
    "test:unit": "node --test test/syyncmatch.test.js",
    "test": "npm run check:responses && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
